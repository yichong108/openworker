# OpenWorker 渠道环境说明（提交到 git，无密钥）
#
# 渠道配置已内联到 packages/shared/src/load-env.ts（BASE_ENVS + CHANNEL_ENVS）。
# 通过环境变量 CHANNEL=dev|test|prod 选择渠道（脚本使用 cross-env）：
#   CHANNEL=dev   — pnpm dev / desktop:dev / native:dev
#   CHANNEL=test  — desktop:build:test
#   CHANNEL=prod  — desktop:build
#
# 进程启动后由 bootstrapChannelEnv 写入 process.env，业务只读 process.env。
# Desktop spawn Native 时只需传递 CHANNEL；Native 自行 bootstrap。
#
# --- 渠道表字段（见 load-env.ts）---
# CHANNEL
# OPENWORKER_PRODUCT_NAME
# OPENWORKER_APP_ID
# OPENWORKER_APP_USER_MODEL_ID
# OPENWORKER_APP_ICON
# OPENWORKER_RENDERER_PORT
# OPENWORKER_NATIVE_PORT
# PORT
# OPENWORKER_DATA_DIR_NAME
# OPENWORKER_NATIVE_BASE_URL
# VITE_API_URL
# VITE_OPENWORKER_NATIVE_BASE_URL
# OPENWORKER_NATIVE_EXTERNAL（仅 dev）
