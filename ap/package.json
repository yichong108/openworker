{
  "name": "@openworker/ap",
  "version": "0.0.0",
  "description": "ai pipeline with Cursor SDK — 用 Cursor SDK 本地 Agent 执行 .agents/skills 中的任意技能",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "tsx src/install-skills.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:dist": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cursor/sdk": "catalog:",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "^4.19.4",
    "typescript": "catalog:"
  }
}
