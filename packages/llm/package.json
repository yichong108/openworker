{
  "name": "@openworker/llm",
  "version": "1.0.0",
  "description": "OpenWorker LLM helpers — chat model factory and streamText wrapper",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yichong108/openworker.git",
    "directory": "packages/llm"
  },
  "bugs": {
    "url": "https://github.com/yichong108/openworker/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "publint": "pnpm run build && publint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-npm-auth": "npm whoami --registry=https://registry.npmjs.org/",
    "release": "pnpm run test && pnpm run check-npm-auth && tsc -p tsconfig.build.json && pnpm publish --access public --no-git-checks"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@ai-sdk/openai": "catalog:",
    "ai": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  }
}
