{
  "name": "openworker",
  "version": "1.0.0-alpha.1",
  "description": "OpenWorker — AI Agent 套件 (桌面应用 + 命令行 + 落地页 + 本地服务)",
  "keywords": [
    "openworker",
    "ai",
    "agent",
    "desktop",
    "cli",
    "landing",
    "langfuse"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yichong108/openworker.git"
  },
  "author": "Wang Zhang",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "turbo run build",
    "dev:prepare": "pnpm --filter @openworker/api docker:up",
    "dev": "turbo run dev --parallel --filter=!@openworker/phone --filter=!@openworker/admin --filter=!@openworker/landing --filter=!@openworker/cli --filter=!@openworker/api",
    "dev:all": "pnpm run dev:prepare && turbo run dev --parallel",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,cjs,js,jsx,json,md,scss,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,cjs,js,jsx,json,md,scss,css}\"",
    "desktop:dev": "pnpm --filter @openworker/desktop dev",
    "desktop:build": "pnpm --filter @openworker/desktop build",
    "desktop:build:app": "pnpm --filter @openworker/desktop build:app",
    "desktop:build:win": "pnpm --filter @openworker/desktop build:win",
    "desktop:build:win:msi": "pnpm --filter @openworker/desktop build:win:msi",
    "desktop:preview": "pnpm --filter @openworker/desktop preview",
    "landing:dev": "pnpm --filter @openworker/landing dev",
    "landing:build": "pnpm --filter @openworker/landing build",
    "admin:dev": "pnpm --filter @openworker/admin dev",
    "admin:build": "pnpm --filter @openworker/admin build",
    "admin:typecheck": "pnpm --filter @openworker/admin typecheck",
    "langfuse:start": "pnpm --filter @openworker/langfuse-local run start",
    "langfuse:stop": "pnpm --filter @openworker/langfuse-local run stop",
    "langfuse:status": "pnpm --filter @openworker/langfuse-local run status",
    "langfuse:logs": "pnpm --filter @openworker/langfuse-local run logs",
    "langfuse:reset": "pnpm --filter @openworker/langfuse-local run reset",
    "rag:setup-ollama": "node scripts/rag/setup-ollama.mjs",
    "api:dev": "pnpm --filter @openworker/api dev",
    "api:build": "pnpm --filter @openworker/api build",
    "api:start": "pnpm --filter @openworker/api start",
    "api:typecheck": "pnpm --filter @openworker/api typecheck",
    "native:dev": "pnpm --filter @openworker/native dev",
    "native:build": "pnpm --filter @openworker/native build",
    "native:start": "pnpm --filter @openworker/native start",
    "native:typecheck": "pnpm --filter @openworker/native typecheck",
    "cli:dev": "pnpm --filter @openworker/cli dev",
    "cli:start": "pnpm --filter @openworker/cli start",
    "cli:build": "pnpm --filter @openworker/cli build",
    "cli:start:dist": "pnpm --filter @openworker/cli start:dist",
    "cli:typecheck": "pnpm --filter @openworker/cli typecheck",
    "phone:dev": "pnpm --filter @openworker/phone dev",
    "phone:start": "pnpm --filter @openworker/phone start",
    "phone:android": "pnpm --filter @openworker/phone android",
    "phone:ios": "pnpm --filter @openworker/phone ios",
    "phone:web": "pnpm --filter @openworker/phone web",
    "phone:typecheck": "pnpm --filter @openworker/phone typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "oxlint": "^1.77.0",
    "prettier": "^3.8.3",
    "turbo": "^2.0.0",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@9.15.9",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
