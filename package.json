{
  "name": "openworker",
  "version": "1.0.0-alpha.1",
  "description": "OpenWorker — AI Agent 套件 (桌面应用 + 落地页 + 本地服务)",
  "keywords": [
    "openworker",
    "ai",
    "agent",
    "desktop",
    "landing"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yichong108/openworker.git"
  },
  "author": "Wang Zhang",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel --filter=!@openworker/landing",
    "dev:all": "turbo run dev --parallel",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,cjs,js,jsx,json,md,scss,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,cjs,js,jsx,json,md,scss,css}\"",
    "desktop:dev": "pnpm --filter @openworker/desktop dev",
    "desktop:build": "pnpm --filter @openworker/desktop build",
    "desktop:build:test": "pnpm --filter @openworker/desktop build:test",
    "landing:dev": "pnpm --filter @openworker/landing dev",
    "landing:build": "pnpm --filter @openworker/landing build",
    "native:dev": "pnpm --filter @openworker/native dev",
    "native:build": "pnpm --filter @openworker/native build",
    "native:start": "pnpm --filter @openworker/native start",
    "native:typecheck": "pnpm --filter @openworker/native typecheck",
    "ap": "pnpm --dir ap exec tsx src/index.ts",
    "ap:build": "pnpm --filter @openworker/ap build",
    "ap:start:dist": "pnpm --filter @openworker/ap start:dist",
    "ap:typecheck": "pnpm --filter @openworker/ap typecheck",
    "ap:publish": "pnpm --filter @openworker/ap publish",
    "ai-pipeline:task-create": "pnpm ap:start:dist task-create",
    "ai-pipeline:task-execute": "pnpm ap:start:dist task-execute",
    "ai-pipeline:decision-create": "pnpm ap:start:dist decision-create",
    "ai-pipeline:refactor": "pnpm ap:start:dist refactor"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "oxlint": "^1.77.0",
    "prettier": "^3.8.3",
    "turbo": "^2.0.0",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@9.15.9",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
