# OpenWorker Desktop 环境变量配置示例
# 复制此文件为 .env.local 并填入实际值
# .env.local 不会被提交到 git

# ===============================
# 发行渠道（由 npm scripts 注入，一般无需手改）
# ===============================
# dev:   pnpm desktop:dev          → OpenWorker Dev  / Native :3200 / ~/.openworker-dev
# test:  pnpm desktop:build:test   → OpenWorker Test / Native :3201 / ~/.openworker-test
# prod:  pnpm desktop:build        → OpenWorker      / Native :3202 / ~/.openworker
# APP_CHANNEL=dev

# ===============================
# Native 本地服务（数据面 + 主进程自动拉起）
# ===============================
# 未设置时按 APP_CHANNEL 默认端口与 OPENWORKER_HOME；已有同端口健康实例时复用
# dev 默认 http://127.0.0.1:3200；test 3201；prod 3202
# OPENWORKER_NATIVE_PORT=3200
# OPENWORKER_NATIVE_BASE_URL="http://127.0.0.1:3200"
# OPENWORKER_HOME 由主进程按渠道注入，通常无需手改
# 开发态强制用 Electron 内嵌 Node（ELECTRON_RUN_AS_NODE）冒烟打包路径：
# OPENWORKER_NATIVE_USE_ELECTRON_NODE=1

# 渲染进程直连 Native（Vite 需 VITE_ 前缀；dev 默认与 Dev 渠道 Native 口一致）
# request.ts 优先读 VITE_API_URL，其次 VITE_OPENWORKER_NATIVE_BASE_URL
# electron-vite 未设置时会按 APP_CHANNEL 注入默认值
VITE_API_URL="http://127.0.0.1:3200"
VITE_OPENWORKER_NATIVE_BASE_URL="http://127.0.0.1:3200"
