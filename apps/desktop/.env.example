# OpenWorker Desktop 环境变量配置示例
# 复制此文件为 .env.local 并填入实际值
# .env.local 不会被提交到 git

# ===============================
# Native 本地服务（数据面 + 主进程自动拉起）
# ===============================
# auth / settings / workspaces / sessions / profile 默认走 Native（:3200）
# 默认 http://127.0.0.1:3200；已有健康实例时复用，不重复 spawn
# OPENWORKER_NATIVE_PORT=3200
# OPENWORKER_NATIVE_BASE_URL="http://127.0.0.1:3200"
# 开发态强制用 Electron 内嵌 Node（ELECTRON_RUN_AS_NODE）冒烟打包路径：
# OPENWORKER_NATIVE_USE_ELECTRON_NODE=1

# 渲染进程直连 Native（Vite 需 VITE_ 前缀；与主进程 Native 地址保持一致）
# request.ts 优先读 VITE_API_URL，其次 VITE_OPENWORKER_NATIVE_BASE_URL
VITE_API_URL="http://127.0.0.1:3200"
VITE_OPENWORKER_NATIVE_BASE_URL="http://127.0.0.1:3200"
