{
  "name": "@openworker/desktop",
  "version": "1.0.0-alpha.1",
  "description": "OpenWorker 桌面应用 — Electron + Ant Design + AI SDK",
  "author": "Wang Zhang",
  "license": "MIT",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "cross-env APP_CHANNEL=dev electron-vite dev",
    "dev:debug": "cross-env APP_CHANNEL=dev electron-vite dev --inspect=9229 --remoteDebuggingPort=9222 --sourcemap",
    "build": "pnpm --filter @openworker/native build && cross-env APP_CHANNEL=prod electron-vite build && cross-env APP_CHANNEL=prod electron-builder --config scripts/electron-builder.config.mjs",
    "build:test": "pnpm --filter @openworker/native build && cross-env APP_CHANNEL=test electron-vite build && cross-env APP_CHANNEL=test electron-builder --config scripts/electron-builder.config.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "electron-log": "^5.4.3",
    "electron-store": "^10.0.0"
  },
  "devDependencies": {
    "@ag-ui/client": "catalog:",
    "@ant-design/icons": "^5.6.1",
    "@monaco-editor/react": "^4.7.0",
    "@openworker/shared": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.3.4",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "antd": "^5.24.6",
    "axios": "^1.19.0",
    "dayjs": "^1.11.13",
    "diff": "^9.0.0",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^5.0.0",
    "cross-env": "^10.1.0",
    "file-icons-js": "^1.1.0",
    "highlight.js": "catalog:",
    "mdast-util-find-and-replace": "^3.0.2",
    "monaco-editor": "^0.55.1",
    "monaco-themes": "^0.4.8",
    "react": "^18.3.1",
    "react-arborist": "^3.5.0",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-use": "^17.6.0",
    "react-window": "^1.8.11",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sass": "^1.99.0",
    "sharp": "^0.34.5",
    "simplebar-core": "^1.3.2",
    "simplebar-react": "^3.3.2",
    "strip-json-comments": "^3.1.1",
    "typescript": "catalog:",
    "vite": "^6.2.6",
    "zod": "catalog:",
    "zustand": "^5.0.12"
  },
  "build": {
    "appId": "com.openworker.desktop",
    "productName": "OpenWorker",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/app-icon.png",
        "to": "app-icon.png"
      },
      {
        "from": "../../packages/skills/content",
        "to": "skills",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../services/native/dist/desktop-bundle.cjs",
        "to": "native/index.cjs"
      },
      {
        "from": "../../services/native/dist/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "msi"
      ],
      "icon": "resources/app-icon.png"
    },
    "msi": {
      "oneClick": false,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "resources/app-icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "resources/app-icon.png"
    }
  }
}
