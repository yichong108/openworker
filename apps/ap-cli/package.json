{
  "name": "@openworker/ap",
  "version": "0.5.0",
  "description": "AI command pipeline with Cursor SDK",
  "keywords": [
    "ap",
    "cursor",
    "agent",
    "skills",
    "cli",
    "openworker"
  ],
  "homepage": "https://github.com/yichong108/openworker/tree/main/apps/ap-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yichong108/openworker.git",
    "directory": "apps/ap-cli"
  },
  "bugs": {
    "url": "https://github.com/yichong108/openworker/issues"
  },
  "author": "Wang Zhang",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ap": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "src/ap-config",
    ".env.example",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "publint": "pnpm run build && publint",
    "check-npm-auth": "npm whoami --registry=https://registry.npmjs.org/",
    "release": "pnpm run check-npm-auth && tsc -p tsconfig.build.json && pnpm publish --access public --no-git-checks",
    "start:dist": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cursor/sdk": "catalog:",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "publint": "catalog:",
    "tsx": "^4.19.4",
    "typescript": "catalog:"
  }
}
