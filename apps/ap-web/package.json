{
  "name": "@openworker/ap-web",
  "version": "0.5.0",
  "description": "OpenWorker 本地任务看板 — Next.js + TypeScript",
  "type": "module",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "predev": "turbo run build --filter=@openworker/llm --filter=@openworker/tools --filter=@openworker/base-agent",
    "pretypecheck": "turbo run build --filter=@openworker/llm --filter=@openworker/tools --filter=@openworker/base-agent",
    "dev": "cross-env BROWSER=none next dev",
    "prebuild": "node scripts/clean-next.mjs",
    "build": "next build",
    "postbuild": "node scripts/materialize-standalone.mjs",
    "prepare-publish": "node scripts/prepare-publish.mjs",
    "check-npm-auth": "npm whoami --registry=https://registry.npmjs.org/",
    "release": "pnpm run check-npm-auth && pnpm run build && node scripts/prepare-publish.mjs && cd .publish-staging && npm publish --access public",
    "start": "next start --port 3010",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ag-ui/client": "catalog:",
    "@ant-design/icons": "^5.6.1",
    "@openworker/ap-agent": "workspace:*",
    "@openworker/llm": "workspace:*",
    "@openworker/shared": "workspace:*",
    "@openworker/ui": "workspace:*",
    "antd": "^5.24.6",
    "dayjs": "catalog:",
    "dotenv": "^17.4.2",
    "next": "14.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "autoprefixer": "^10.4.19",
    "cross-env": "^10.1.0",
    "postcss": "^8.4.38",
    "sass": "^1.99.0",
    "tailwindcss": "^3.4.3",
    "typescript": "catalog:"
  }
}
