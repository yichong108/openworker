# OpenWorker API 服务环境变量示例
# 复制为 .env 后按本地环境修改:
#   cp .env.example .env
#
# 本地 MySQL / Redis 可通过 Docker 启动（与 langfuse-local 独立）:
#   pnpm docker:up

# 服务端口
PORT=3100

# JWT（登录签发 access token；生产环境务必更换）
JWT_SECRET=openworker-dev-jwt-secret-change-me
JWT_EXPIRES_IN=7d

# MySQL（docker-compose 会读取 MYSQL_PASSWORD / MYSQL_DATABASE / MYSQL_PORT）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=openworker

# Redis（docker-compose 会读取 REDIS_PORT / REDIS_PASSWORD）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 知识库：原文与索引根目录（每库子目录含 files/、index.json、可选 llamaindex/）
RAG_DATA_DIR=./data/rag

# RAG embedding：none=关键词；ollama=LlamaIndex + 本地 Ollama（可用 pnpm rag:setup-ollama 安装并写入 .env）
RAG_EMBEDDING_PROVIDER=none
RAG_OLLAMA_BASE_URL=http://127.0.0.1:11434
RAG_OLLAMA_EMBED_MODEL=nomic-embed-text

# 可选：RAG 测试「生成回答」用的 OpenAI 兼容 Chat（如 DeepSeek）
# RAG_LLM_API_KEY=
# RAG_LLM_BASE_URL=https://api.deepseek.com
# RAG_LLM_MODEL=deepseek-chat
