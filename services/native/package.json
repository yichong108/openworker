{
  "name": "@openworker/native",
  "version": "0.0.0",
  "description": "OpenWorker native local service — Express + SQLite + Agent/SSE",
  "type": "module",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.build.json && node esbuild.config.mjs",
    "bundle": "node esbuild.config.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@ag-ui/client": "catalog:",
    "@openworker/memory": "workspace:*",
    "@openworker/shared": "workspace:*",
    "@openworker/uni-agent": "workspace:*",
    "ai": "catalog:",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/node": "catalog:",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.4",
    "typescript": "catalog:"
  }
}
