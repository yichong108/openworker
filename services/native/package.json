{
  "name": "@openworker/native",
  "version": "0.0.0",
  "description": "OpenWorker native local service — Express + SQLite + Agent/SSE",
  "type": "module",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "cross-env CHANNEL=dev tsx watch src/index.ts",
    "build": "cross-env CHANNEL=prod tsc -p tsconfig.build.json && node esbuild.config.mjs",
    "build:test": "cross-env CHANNEL=test tsc -p tsconfig.build.json && node esbuild.config.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@ag-ui/client": "catalog:",
    "@openworker/log": "workspace:*",
    "@openworker/base-agent": "workspace:*",
    "@openworker/llm": "workspace:*",
    "@openworker/memory": "workspace:*",
    "@openworker/mcp": "workspace:*",
    "@openworker/shared": "workspace:*",
    "@openworker/skills": "workspace:*",
    "@openworker/tools": "workspace:*",
    "@openworker/agent": "workspace:*",
    "ai": "catalog:",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/node": "catalog:",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.4",
    "typescript": "catalog:"
  }
}
