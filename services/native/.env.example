# HTTP listen port (default: 3200; Desktop 按渠道注入 3200/3201/3202)
PORT=3200

# OpenWorker 用户数据根（Desktop 按渠道注入，如 ~/.openworker-dev）
# OPENWORKER_HOME=

# SQLite database file path.
# Default (when unset): {OPENWORKER_HOME}/native/native.sqlite 或 ~/.openworker/native/native.sqlite
# Override for isolated/local testing, e.g.:
# SQLITE_PATH=./data/native.sqlite
# SQLITE_PATH=
