# HTTP listen port (default: 3200)
PORT=3200

# SQLite database file path.
# Default (when unset): ~/.openworker/native/native.sqlite
# Override for isolated/local testing, e.g.:
# SQLITE_PATH=./data/native.sqlite
# SQLITE_PATH=

# JWT (aligned with services/api defaults for local debugging)
JWT_SECRET=openworker-dev-jwt-secret-change-me
JWT_EXPIRES_IN=7d
